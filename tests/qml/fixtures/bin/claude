#!/bin/sh
# A fake `claude` for the QML tests and visual scenarios (the scripts put
# it first on PATH). It records its arguments, folder and pid, then sets the
# terminal's title the way Claude Code does: "✳ Claude Code" while idle.
# Each line typed to it: "work" turns a half circle a while and names the
# conversation, "quit" exits; anything else is recorded after the arguments.
printf '%s\n%s\n%s\n' "$*" "$PWD" "$$" > "${NOTCHD_FAKE_CLAUDE_ARGS:-/dev/null}"
title() { printf '\033]0;%s\007' "$1"; }
name="Claude Code"
title "✳ $name"
echo "fake claude ready"
while IFS= read -r line; do
  case "$line" in
    work)
      title "◐ $name"; sleep 0.3
      name="Fake conversation"
      title "◑ $name"; sleep 0.3
      title "✳ $name"; echo "worked" ;;
    quit) echo "bye"; exit 0 ;;
    *) echo "got: $line"; printf 'got %s\n' "$line" >> "${NOTCHD_FAKE_CLAUDE_ARGS:-/dev/null}" ;;
  esac
done
