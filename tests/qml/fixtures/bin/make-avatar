#!/bin/sh
# A fake core/avatar/make-avatar.py for the QML tests and visual scenarios
# ($NOTCHD_AVATAR_PIPELINE): the same arguments and output lines, no
# models. It copies tests/qml/fixtures/avatar (a drawn head, no one's face)
# into --out. A photo named *noface* fails as the real one does without a
# face; *missing* as it does without its packages.
while [ $# -gt 0 ]; do
  case "$1" in
    --photo) photo=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --models) shift 2 ;;
    *) shift ;;
  esac
done
case "$photo" in
  *missing*) echo '{"error": "missing", "packages": ["python-mediapipe"]}'; exit 2 ;;
esac
echo '{"step": "download", "progress": 0.5}'
echo '{"step": "load"}'
case "$photo" in
  *noface*) echo '{"error": "No face found in the photo. Try one where the face is clear and from the front."}'; exit 1 ;;
esac
echo '{"step": "depth"}'
fixture=$(dirname -- "$0")/../avatar
rm -rf -- "$out.tmp" && mkdir -p -- "$out.tmp" && cp -- "$fixture"/* "$out.tmp"/ || exit 1
rm -rf -- "$out" && mv -- "$out.tmp" "$out"
echo '{"done": true}'
