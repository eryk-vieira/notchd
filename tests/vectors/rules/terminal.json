    {"name":"a tilde slash alone","fn":"expandHome","args":["~/","/home/u"],"expected":"/home/u/","source":"added"},
    {"name":"a tilde in the middle","fn":"expandHome","args":["a/~/b","/home/u"],"expected":"a/~/b","source":"added"},
    {"name":"a number path","fn":"expandHome","args":[5,"/h"],"expected":"5","source":"added"},
    {"name":"blanks around the tilde","fn":"expandHome","args":["\t~\n","/home/u"],"expected":"/home/u","source":"added"},
    {"name":"a command, run with exec","fn":"shellArgs","args":["codex --search",[],false,false],"expected":["-c","TERM=xterm-256color; export TERM; exec codex --search \"$@\"","sh"],"source":"tests"},
    {"name":"with extra arguments after it","fn":"shellArgs","args":["codex",["--resume","a b"],false,false],"expected":["-c","TERM=xterm-256color; export TERM; exec codex \"$@\"","sh","--resume","a b"],"source":"tests"},
    {"name":"in notchd's own folder","fn":"shellArgs","args":["claude",[],true,false],"expected":["-c","d=$(xdg-user-dir DOCUMENTS 2>/dev/null); if [ -z \"$d\" ] || [ \"$d\" = \"$HOME\" ]; then d=\"$HOME/Documents\"; fi; d=\"$d/notchd\"; mkdir -p -- \"$d\" && cd -- \"$d\"; TERM=xterm-256color; export TERM; exec claude \"$@\"","sh"],"source":"tests"},
    {"name":"a script of its own","fn":"shellArgs","args":["cd ~/app && npm run dev",[],false,true],"expected":["-c","TERM=xterm-256color; export TERM; cd ~/app && npm run dev","sh"],"source":"tests"},
    {"name":"a script with the own folder and extras","fn":"shellArgs","args":["a; b",["x"],true,true],"expected":["-c","d=$(xdg-user-dir DOCUMENTS 2>/dev/null); if [ -z \"$d\" ] || [ \"$d\" = \"$HOME\" ]; then d=\"$HOME/Documents\"; fi; d=\"$d/notchd\"; mkdir -p -- \"$d\" && cd -- \"$d\"; TERM=xterm-256color; export TERM; a; b","sh","x"],"source":"added"},
    {"name":"the command is trimmed","fn":"shellArgs","args":["  codex  ",[],false,false],"expected":["-c","TERM=xterm-256color; export TERM; exec codex \"$@\"","sh"],"source":"added"},
    {"name":"a null command","fn":"shellArgs","args":[null,[],false,false],"expected":["-c","TERM=xterm-256color; export TERM; exec  \"$@\"","sh"],"source":"added"},
    {"name":"a null extra","fn":"shellArgs","args":["x",null,false,false],"expected":["-c","TERM=xterm-256color; export TERM; exec x \"$@\"","sh"],"source":"added"},
    {"name":"an empty command","fn":"shellArgs","args":["",[],false,false],"expected":["-c","TERM=xterm-256color; export TERM; exec  \"$@\"","sh"],"source":"added"},
    {"name":"a script, trimmed","fn":"shellArgs","args":["  a; b  ",[],false,true],"expected":["-c","TERM=xterm-256color; export TERM; a; b","sh"],"source":"added"},
    {"name":"extra with quotes and newlines","fn":"shellArgs","args":["x",["a\"b","c\nd",""],false,false],"expected":["-c","TERM=xterm-256color; export TERM; exec x \"$@\"","sh","a\"b","c\nd",""],"source":"added"},
