    {"name":"null is the home","fn":"expandHome","args":[null,"/home/u"],"expected":"/home/u","source":"added"},
    {"name":"padded","fn":"expandHome","args":["  ~/x  ","/home/u"],"expected":"/home/u/x","source":"added"},
    {"name":"another path as given","fn":"expandHome","args":["/opt/x","/home/u"],"expected":"/opt/x","source":"tests"},
    {"name":"a relative path as given","fn":"expandHome","args":["x/y","/home/u"],"expected":"x/y","source":"added"},
    {"name":"a trailing slash on the home","fn":"expandHome","args":["~/x","/home/u/"],"expected":"/home/u/x","source":"added"},
    {"name":"several trailing slashes","fn":"expandHome","args":["~/x","/home/u///"],"expected":"/home/u/x","source":"added"},
