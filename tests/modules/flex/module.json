{
  "title": "Flex",
  "command": ["./run.sh"],
  "icon": "F",
  "settings": [
    { "key": "query", "type": "string", "label": "Gmail search", "default": "FLEX newer_than:10d",
      "help": "Gmail search Codex starts from. It may search again by reference or HBL for context." },
    { "key": "interval", "type": "integer", "label": "Check every", "default": 30, "min": 10, "max": 240, "step": 5, "unit": "min",
      "help": "Each check waits up to 3 minutes more or less, so checks don't line up with other jobs." },
    { "key": "weekdays", "type": "boolean", "label": "Weekdays only", "default": true },
    { "key": "reasoning", "type": "choice", "label": "Codex reasoning", "default": "low",
      "help": "How long Codex thinks before it answers.",
      "options": [{ "value": "low", "label": "Low" }, { "value": "medium", "label": "Medium" }, { "value": "high", "label": "High" }] },
    { "key": "compactStyle", "type": "choice", "label": "Closed notch", "default": "counts",
      "options": [{ "value": "counts", "label": "Open processes and alerts" }, { "value": "high", "label": "High alerts only" },
                  { "value": "ticker", "label": "Ticker of the latest news" }, { "value": "dots", "label": "A dot per process" }] }
  ]
}
